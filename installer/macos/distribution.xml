<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>MoonVerb</title>
  <welcome file="welcome.txt"/>
  <license file="LICENSE"/>
  <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <choices-outline>
    <line choice="vst3"/>
    <line choice="au"/>
    <line choice="standalone"/>
  </choices-outline>
  <choice id="vst3" title="VST3 plug-in" description="Installs to /Library/Audio/Plug-Ins/VST3"><pkg-ref id="com.moontechnologies.moonverb.vst3"/></choice>
  <choice id="au" title="Audio Unit plug-in" description="Installs to /Library/Audio/Plug-Ins/Components"><pkg-ref id="com.moontechnologies.moonverb.au"/></choice>
  <choice id="standalone" title="Standalone app" description="Installs MoonVerb.app to /Applications"><pkg-ref id="com.moontechnologies.moonverb.standalone"/></choice>
  <pkg-ref id="com.moontechnologies.moonverb.vst3" auth="Root">MoonVerb-VST3.pkg</pkg-ref>
  <pkg-ref id="com.moontechnologies.moonverb.au" auth="Root">MoonVerb-AU.pkg</pkg-ref>
  <pkg-ref id="com.moontechnologies.moonverb.standalone" auth="Root">MoonVerb-Standalone.pkg</pkg-ref>
</installer-gui-script>
